# Produkce: Neon Postgres (region EU). Bez proměnné běží lokální PGlite (.data/danero).
DATABASE_URL=

# Better Auth — v produkci povinné (openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Šifrování broker API klíčů (AES-256-GCM) — v produkci povinné (openssl rand -hex 32)
DANERO_ENCRYPTION_KEY=

# Výměna šifrovacího klíče: sem přijdou ty vyřazené (hex oddělené čárkou).
# Šifruje se vždy tím aktuálním, ale data zašifrovaná těmi starými se dál čtou —
# bez toho by se po výměně klíče uložené broker klíče nedaly přečíst.
DANERO_ENCRYPTION_KEYS_OLD=

# Ochrana cron endpointů (/api/cron/*)
CRON_SECRET=

# Vlastní instance (Docker): 1 = zmigruj Postgres při startu. Jen pro jednu
# instanci — jinak migruj v deployi přes `drizzle-kit migrate`.
DANERO_MIGRATE_ON_START=

# E-mailové notifikace (Resend). Bez klíče se e-maily jen logují (dev).
RESEND_API_KEY=
RESEND_FROM="Danero <notifikace@danero.cz>"

# Platby (Stripe). DANERO_BILLING=stripe zapne placené tarify; bez toho má
# každý všechno zdarma (tak jede self-hosting). Se zapnutými platbami jsou
# ostatní STRIPE_* proměnné povinné.
DANERO_BILLING=
STRIPE_SECRET_KEY=
# ID cen ze Stripe (Products → Pricing): jednorázový podklad a předplatné
STRIPE_PRICE_REPORT=
STRIPE_PRICE_SUBSCRIPTION=
# Podpis webhooku (Stripe → Developers → Webhooks); bez něj se platby nepotvrdí
STRIPE_WEBHOOK_SECRET=

# Za jakou proxy aplikace běží — seznam IP/CIDR oddělený čárkou. Určuje, které
# hopy v X-Forwarded-For se přeskočí při hledání IP klienta (klíč rate limitu).
# Nevyplněno = výchozí seznam privátních rozsahů (Vercel i běžná proxy).
DANERO_TRUSTED_PROXIES=

# Identifikace provozovatele — § 435 OZ (na webu) a § 1820 odst. 1 písm. c) OZ
# (u smluv na dálku). Schválně JEN v prostředí, ne v repozitáři: repozitář je
# veřejný a pod AGPL, takže by si každý, kdo si Danero rozjede sám, vozil s sebou
# identifikaci cizího člověka — a hlavně jednou commitnutá adresa z historie
# nezmizí ani po přestěhování.
#
# Bez nich se na stránkách vypíše „nenastaveno" a /api/health hlásí
# `operatorContact: "incomplete"`. U placené služby to nenechávej tak.
DANERO_OPERATOR_NAME=
DANERO_OPERATOR_ICO=
DANERO_OPERATOR_ADDRESS=
DANERO_CONTACT_EMAIL=
DANERO_CONTACT_PHONE=
