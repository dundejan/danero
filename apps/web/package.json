    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "~16.2.12",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.2",
    "resend": "^4.0.0",
    "stripe": "^22.4.0",
