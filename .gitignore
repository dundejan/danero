# Oddělené distDiry (NEXT_DIST_DIR) — E2E i ladicí běhy vedle spuštěného
# `pnpm dev`. Glob schválně: každý nový běh si zakládá vlastní adresář
# (.next-e2e, .next-paywall, .next-a11y…) a vyjmenovávat je po jednom
# znamenalo, že se dřív nebo později některý commitne.
.next-*/
# tsconfig odvozený pro vlastní distDir — zakládá ho next.config.ts, aby Next
# nepřipisoval cesty typů do verzovaného tsconfig.json
apps/web/tsconfig.next-*.json
next-env.d.ts
.turbo/
coverage/
# mutační testy (Stryker): report a pískoviště
reports/
.stryker-tmp/
*.log
.env
.env.*
!.env.example
.DS_Store

# reálné exporty pro lokální ověření importu (nikdy necommitovat)
packages/importers/test/fixtures/real/

.data/

# Playwright artefakty
apps/web/test-results/
apps/web/playwright-report/

*.tsbuildinfo
